# supabase for real cloud accounts, local for reference server, demo for local guest
VITE_BACKEND_MODE=demo
# GitHub Pages build sets /LifeCity3D/; keep / for local development.
VITE_BASE_PATH=/
# browser for the dedicated repository; hash is restricted to a local guest preview
VITE_ROUTER_MODE=browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set true only after enabling Google in Supabase Authentication providers.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_API_BASE=/api
LOCAL_DATABASE_PATH=.data/lifecity
LOCAL_API_PORT=4174
LOCAL_API_HOST=127.0.0.1
LOCAL_COOKIE_SECURE=false
# Optional exact browser origins for the local reference server, comma separated.
LOCAL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public project URL/key are also supplied by deployment/client-service.json.
# Its enabled flag stays false until hosted Auth redirects/email are verified.
# Use VITE_BACKEND_MODE=supabase for an explicit local cloud test; never add a secret key.
